<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme: dark, no action bar. Compose owns the UI; edge-to-edge (bar colours,
         cutout mode) is set up by enableEdgeToEdge() in MainActivity, not by deprecated attrs. -->
    <style name="Theme.NightDrive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_background</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Splash screen shown on cold start (androidx core-splashscreen). -->
    <style name="Theme.NightDrive.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NightDrive</item>
    </style>
</resources>
